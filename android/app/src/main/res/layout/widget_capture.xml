<?xml version="1.0" encoding="utf-8"?>
<!-- The quick-capture widget (FR-14): one tap opens capture. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pill"
    android:contentDescription="@string/widget_capture_hint"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_add" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="@string/widget_capture_hint"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="16sp" />
</LinearLayout>

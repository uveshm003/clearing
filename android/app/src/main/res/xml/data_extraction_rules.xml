<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (PRD §7): the database never goes to cloud backup, since
     Clearing promises nothing leaves the phone, but it does move with a
     device-to-device transfer to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

  "fixed_sql": [
    {
      "name": "lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon\" TEXT NULL, \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "series",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"series\" (\"id\" TEXT NOT NULL, \"freq\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1, \"weekdays\" INTEGER NULL, \"month_day\" INTEGER NULL, \"start_date\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"max_count\" INTEGER NULL, \"mode\" TEXT NOT NULL DEFAULT 'fixed', \"on_missed\" TEXT NOT NULL, \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)), \"template\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"done_means\" TEXT NULL, \"status\" TEXT NOT NULL, \"when_horizon\" TEXT NULL, \"horizon_set_on\" TEXT NULL, \"do_date\" TEXT NULL, \"do_time\" INTEGER NULL, \"deadline\" TEXT NULL, \"must_do\" INTEGER NOT NULL DEFAULT 0 CHECK (\"must_do\" IN (0, 1)), \"list_id\" TEXT NULL REFERENCES lists (id) ON DELETE SET NULL, \"waiting_on\" TEXT NULL, \"follow_up_date\" TEXT NULL, \"series_id\" TEXT NULL REFERENCES series (id) ON DELETE SET NULL, \"occurrence_date\" TEXT NULL, \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"completed_at\" TEXT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"trashed_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"done\" IN (0, 1)), \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id) ON DELETE CASCADE, \"offset_minutes\" INTEGER NULL, \"fire_at\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"snoozed_until\" TEXT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK ((offset_minutes IS NULL) != (fire_at IS NULL)));"
        }
      ]
    },
    {
      "name": "templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"templates\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"items\" TEXT NOT NULL, \"series_id\" TEXT NULL REFERENCES series (id) ON DELETE SET NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "starter_suggestions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"starter_suggestions\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"list_kind\" TEXT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"user_created\" INTEGER NOT NULL DEFAULT 0 CHECK (\"user_created\" IN (0, 1)), \"sort_order\" REAL NOT NULL DEFAULT 0.0, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {

  "settingsTipsReset": "सुझाव फिर से दिखेंगे",
  "settingsReplayWelcome": "स्वागत फिर से देखें",
  "settingsReplayWelcomeHint": "टूर, और ज़रूरी चीज़ें सेट करना",
  "helpTitle": "मदद और गाइड",
  "helpSubtitle": "गाइड, सवाल और जवाब",
  "helpGetStarted": "शुरुआत",
  "helpGuides": "गाइड",
  "helpMore": "और मदद",
  "helpTourHint": "पाँच छोटे पेज",
  "guideCaptureTitle": "विचार लिख लेना",
  "guideCaptureLead": "पहले दिमाग़ से बाहर निकालें; फ़ैसला बाद में।",
  "guideCapture1Title": "कहीं से भी + दबाएँ",
  "guideCapture1Body": "लिखने का बटन हर टैब पर है। एक लाइन लिखें और Enter दबाएँ; अगली बात के लिए जगह खुली रहती है।",
  "guideCapture2Title": "एक साथ सब चिपकाएँ",
  "guideCapture2Body": "एक साथ कई लाइनें चिपकाएँ, हर लाइन अलग काम बन जाएगी।",
  "guideCapture3Title": "दूसरे ऐप से शेयर करें",
  "guideCapture3Body": "किसी मैसेज या वेब पेज का टेक्स्ट Clearing में शेयर करके लिख लें।",
  "guideCapture4Title": "होम स्क्रीन से",
  "guideCapture4Body": "झटपट लिखें विजेट जोड़ें: होम स्क्रीन को दबाकर रखें, फिर विजेट › Clearing।",
  "guideDecideTitle": "तय करना कि क्या करना है",
  "guideDecideLead": "इनबॉक्स की हर बात को कुछ टैप में जगह मिलती है।",
  "guideDecide1Title": "एक-एक कदम में स्पष्ट करें",
  "guideDecide1Body": "इनबॉक्स के किसी काम पर टैप करें। Clearing पूछता है: क्या कुछ करना है, अगला कदम क्या है, क्या कोई और कर रहा है, और कब?",
  "guideDecide2Title": "स्वाइप के शॉर्टकट",
  "guideDecide2Body": "दाएँ स्वाइप: आज या इस हफ़्ते। बाएँ स्वाइप: तारीख़ चुनें, किसी दिन के लिए रखें, या हटाएँ।",
  "guideDecide3Title": "पूरा होने का मतलब…",
  "guideDecide3Body": "जो काम धुंधला लगे, उसमें लिखें कि पूरा होना कैसा दिखेगा, और उसे चरणों में बाँटें।",
  "guideDecide4Title": "किसी के इंतज़ार में",
  "guideDecide4Body": "अगर कोई और कर रहा है, तो लिखें कौन, और कब पूछना है।",
  "guideTodayTitle": "आज और ज़रूरी काम",
  "guideTodayLead": "आज वही दिखाता है जो आपने आज के लिए तय किया, और उसे छोटा रखता है।",
  "guideToday1Title": "ज़रूरी काम",
  "guideToday1Body": "ज़्यादा से ज़्यादा तीन सच में ज़रूरी कामों पर स्टार लगाएँ। बाकी सब नीचे दिखता रहता है।",
  "guideToday2Title": "पिछले दिनों से बाकी",
  "guideToday2Body": "पिछले दिनों के काम नीचे चुपचाप इंतज़ार करते हैं। कुछ भी लाल नहीं होता।",
  "guideToday3Title": "इस हफ़्ते",
  "guideToday3Body": "इस हफ़्ते के काम, बिना किसी दिन के, एक ही पंक्ति में रहते हैं।",
  "guideToday4Title": "हो गया, और वापस लेना",
  "guideToday4Body": "हो जाने पर गोले पर टैप करें। मन बदल गया? वापस लें दबाएँ, या सूचियाँ › पूरे हुए में टिक हटाएँ।",
  "guideTimeTitle": "तारीख़ें, रिमाइंडर और दोहराना",
  "guideTimeLead": "कब करेंगे, कब तक करना है, और कब याद दिलाना है, ये तीन अलग बातें हैं।",
  "guideTime1Title": "कब करें, आख़िरी तारीख़, याद दिलाएँ",
  "guideTime1Body": "“कब” वह दिन है जब आप करने वाले हैं। आख़िरी तारीख़ वह है जब तक करना है। रिमाइंडर एक सूचना है; तीन तक लगा सकते हैं।",
  "guideTime2Title": "दोहराना",
  "guideTime2Body": "हर दिन, हर हफ़्ते, हर महीने, या पूरा करने के बाद से गिनकर (जैसे बाल कटवाना)। छूटे हुए दोहराव कभी जमा नहीं होते।",
  "guideTime3Title": "शांत समय",
  "guideTime3Body": "पहले वाले रिमाइंडर सुबह तक रुकते हैं; जिनका समय आपने ख़ुद तय किया, वे समय पर आते हैं।",
  "guideTime4Title": "सुबह का सार",
  "guideTime4Body": "सेटिंग्स › रिमाइंडर में हर सुबह आज के ज़रूरी कामों की एक सूचना चालू करें।",
  "guideReviewTitle": "समीक्षा और मन हल्का करना",
  "guideReviewLead": "दो छोटी आदतें जो मन को साफ़ रखती हैं।",
  "guideReview1Title": "साप्ताहिक समीक्षा",
  "guideReview1Body": "लगभग 15 मिनट: मन ख़ाली करें, इनबॉक्स सँभालें, पिछले हफ़्ते को देखें और अगले की तैयारी करें।",
  "guideReview2Title": "बोझ हल्का करें",
  "guideReview2Body": "जब सब बहुत ज़्यादा लगे, पाँच छोटे कदम सब कुछ एक काम तक ले आते हैं।",
  "guideReview3Title": "फ़ोकस",
  "guideReview3Body": "सिर्फ़ एक काम दिखाता है, और कुछ नहीं, जब तक वह पूरा न हो।",
  "guideReview4Title": "वर्कशीट प्रिंट करें",
  "guideReview4Body": "आज या इस हफ़्ते को एक पेज पर प्रिंट करें, लिखने की जगह के साथ।",
  "guideOrganizeTitle": "सूचियाँ, समय-खंड और टेम्पलेट",
  "guideOrganizeLead": "कामों को जगह के हिसाब से रखें, और बार-बार होने वाले काम दोबारा इस्तेमाल करें।",
  "guideOrganize1Title": "सूचियाँ",
  "guideOrganize1Body": "ज़िंदगी के काम, बाहर के काम, और आपकी अपनी सूचियाँ। कोई काम सूची में भी हो सकता है और किसी दिन के लिए तय भी।",
  "guideOrganize2Title": "समय-खंड",
  "guideOrganize2Body": "पूरी सूची के लिए समय तय करें, जैसे शनिवार सुबह बाहर के काम, और वह आज में एक ही पंक्ति में दिखेगा।",
  "guideOrganize3Title": "टेम्पलेट और दिनचर्या",
  "guideOrganize3Body": "बार-बार काम आने वाली चेकलिस्ट सहेजें। किसी को दिनचर्या बनाएँ, वह अपने समय पर आ जाएगी।",
  "guideOrganize4Title": "खोजें",
  "guideOrganize4Body": "खोज आइकन से कुछ भी ढूँढें, पूरे हुए काम भी।",
  "guideDataTitle": "आपका डेटा और निजता",
  "guideDataLead": "Clearing सब कुछ इसी फ़ोन पर रखता है।",
  "guideData1Title": "न खाता, न इंटरनेट",
  "guideData1Body": "न कोई सर्वर, न कोई ट्रैकिंग; यह ऐप इंटरनेट से जुड़ ही नहीं सकता।",
  "guideData2Title": "बैकअप",
  "guideData2Body": "सेटिंग्स › बैकअप में एक कॉपी एक्सपोर्ट करें, और किसी भी फ़ोन पर रीस्टोर करें।",
  "guideData3Title": "नया फ़ोन",
  "guideData3Body": "Android का फ़ोन-से-फ़ोन ट्रांसफ़र Clearing का डेटा साथ ले आता है, या बैकअप का इस्तेमाल करें।",
  "guideData4Title": "ट्रैश और आर्काइव",
  "guideData4Body": "हटाए गए काम 30 दिन ट्रैश में रहते हैं; पूरे हुए काम आर्काइव में जाते हैं और खोजे जा सकते हैं।",

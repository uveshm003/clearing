  "faqWhereKeptA": "Only on this phone. Clearing has no account, no server and no internet access, so nothing you write leaves the phone unless you export it.",
  "@faqWhereKeptA": {
    "description": "FAQ answer."
  },
  "faqNewPhoneQ": "How do I move to a new phone?",
  "@faqNewPhoneQ": {
    "description": "FAQ question."
  },
  "faqNewPhoneA": "Use Settings › Backup › Share a backup, and send the file somewhere you can reach from the new phone (email it to yourself, or save it to Drive). On the new phone, install Clearing and choose Restore from a backup. Android’s phone-to-phone transfer also moves Clearing’s data when you set up a new phone.",
  "@faqNewPhoneA": {
    "description": "FAQ answer. Mentions in-app menu path Settings › Backup."
  },
  "faqUninstallQ": "What happens if I uninstall Clearing?",
  "@faqUninstallQ": {
    "description": "FAQ question."
  },
  "faqUninstallA": "Everything in it is deleted with the app. Export a backup first if you might want it back. Clearing reminds you to export once a month, and you can change how often in Backup.",
  "@faqUninstallA": {
    "description": "FAQ answer."
  },
  "faqTwoDevicesQ": "Can I use Clearing on two devices?",
  "@faqTwoDevicesQ": {
    "description": "FAQ question."
  },
  "faqTwoDevicesA": "Not in sync: each phone keeps its own copy. You can move things across with a backup: Restore › Merge adds what’s missing and keeps the newer copy of anything on both.",
  "@faqTwoDevicesA": {
    "description": "FAQ answer."
  },
  "faqUndoQ": "I did something by mistake. Can I undo it?",
  "@faqUndoQ": {
    "description": "FAQ question."
  },
  "faqUndoA": "Right after completing, deleting or moving an item, tap Undo on the note at the bottom of the screen. Deleted items stay in Lists › Trash for 30 days. Done items are in Lists › Done; untick one to bring it back.",
  "@faqUndoA": {
    "description": "FAQ answer. 'Undo' refers to the snackbar button."
  },
  "faqCarriedOverQ": "What does “carried over” mean?",
  "@faqCarriedOverQ": {
    "description": "FAQ question."
  },
  "faqCarriedOverA": "Something planned for an earlier day that isn’t done yet. It stays on Today, quietly, until you do it or move it. Nothing turns red and nothing is counted against you.",
  "@faqCarriedOverA": {
    "description": "FAQ answer."
  },
  "faqMissedRepeatQ": "What happens when I miss a repeating item?",
  "@faqMissedRepeatQ": {
    "description": "FAQ question."
  },
  "faqMissedRepeatA": "You choose per item. “Carry it over” keeps the missed one on Today until done, and the next one waits. “Skip it quietly” lets it go and starts fresh. Either way, missed days never pile up.",
  "@faqMissedRepeatA": {
    "description": "FAQ answer. Quoted option names refer to the repeat editor's missed-item choices."
  },
  "faqMustDoLimitQ": "Why is Today limited to a few must-dos?",
  "@faqMustDoLimitQ": {
    "description": "FAQ question."
  },
  "faqMustDoLimitA": "A short list gets done; a long one turns into guilt. Everything else stays visible below. You can change the limit (1 to 5) in Settings.",
  "@faqMustDoLimitA": {
    "description": "FAQ answer."
  },
  "faqNoStreaksQ": "Why are there no streaks or scores?",
  "@faqNoStreaksQ": {
    "description": "FAQ question."
  },
  "faqNoStreaksA": "They make a missed day feel like failure. Clearing counts what you cleared and planned, and nothing else.",
  "@faqNoStreaksA": {
    "description": "FAQ answer."
  },

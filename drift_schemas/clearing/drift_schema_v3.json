          "sql": "CREATE TABLE IF NOT EXISTS \"batch_blocks\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL REFERENCES lists (id) ON DELETE CASCADE, \"date\" TEXT NULL, \"weekday\" INTEGER NULL, \"time\" INTEGER NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK ((date IS NULL) != (weekday IS NULL)));"
